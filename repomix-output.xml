      "ice-cream-cone": '<path d="M12 17c-2 0-3.5-1.6-3.5-3.5S10 6 12 3c2 3 3.5 6.6 3.5 10.5S14 17 12 17Z"/><path d="m10 16-1.5 5.5 3.5-2 3.5 2L14 16"/>',
      "cigarette": '<path d="M2 12h13v3H2z"/><path d="M15 12h5a2 2 0 0 1 2 2v-1a2 2 0 0 0-2-2h-5v3Z"/><path d="M6 8c1 1 1 2.5 0 3.5M9 8c1 1 1 2.5 0 3.5"/>',
      "cup-soda": '<path d="M8 2h8l-1 4H9L8 2Z"/><path d="M7 6h10l-1.2 14.2a2 2 0 0 1-2 1.8H10.2a2 2 0 0 1-2-1.8L7 6Z"/><path d="M7.5 11h9"/>',
      "shopping-basket": '<path d="m5 11 4-6"/><path d="m19 11-4-6"/><path d="M2 11h20l-1.6 8.2a2 2 0 0 1-2 1.8H5.6a2 2 0 0 1-2-1.8L2 11Z"/><path d="M12 16v-3"/>'
    };
    const DEFAULT_ICON = '<circle cx="12" cy="12" r="9"/>';

    function kasirApp() {
      return {
        // ---- state ----
        loading: true,
        online: navigator.onLine,
        lastSynced: null,
        query: "",
        allProducts: [],
        allCategories: [],
        selectedCategory: null,
        results: [],
        fuse: null,
        scanNotice: "",
        isScanResult: false,
        viewMode: localStorage.getItem(VIEW_MODE_KEY) || "list",
        zoomedProduct: null,
        selectedProduct: null,

        // ---- navigasi/back-stack (home <-> browsing <-> overlay) ----
        _nav: ["home"],

        // ---- scanner state ----
        scannerOpen: false,
        scannerState: "idle",
        html5QrCode: null,
        isProcessingScan: false,
        lastScannedBarcode: "",

        // ---- lifecycle ----
        init() {
          this.$nextTick(() => this.$refs.searchInput.focus());
          window.addEventListener("online", () => { this.online = true; this.loadData(); });
          window.addEventListener("offline", () => { this.online = false; });

          history.replaceState({ koperasiView: "home" }, "");
          this._nav = ["home"];

          window.addEventListener("popstate", (event) => {
            if (this._nav.length <= 1) {
              this._nav = ["home"];
              this.closeScannerInternal();
              this.zoomedProduct = null;
              this.selectedProduct = null;
              this.resetViewState();
              return;
            }

            const closed = this._nav.pop();
            const now = this._nav[this._nav.length - 1];

            if (closed === "scanner") this.closeScannerInternal();
            if (closed === "zoom") this.zoomedProduct = null;
            if (closed === "detail") this.selectedProduct = null;
            if (closed === "browsing" && now === "home") this.resetViewState();
          });

          // Update stale status secara periodik tanpa reload
          if (!this._staleInterval) {
            this._staleInterval = setInterval(() => {
              // Force Alpine reactivity update
              this._staleCheck = !this._staleCheck;
            }, 60000); // cek setiap menit
          }

          this.loadData();
        },

        navPush(view) {
          this._nav.push(view);
          history.pushState({ koperasiView: view }, "");
        },
        navReplace(view) {
          this._nav[this._nav.length - 1] = view;
          history.replaceState({ koperasiView: view }, "");
        },

        // ---- data loading ----
        async loadData() {
          try {
            const fetchPromise = Promise.all([
              supabaseClient
                .from("public_catalog")
                .select("id,name,alias,barcode,category_id,category_name,category_icon,prices,location_shelf,image_url"),
              supabaseClient
                .from("categories")
                .select("id,name,icon,is_quick_access,sort_order")
                .order("sort_order", { ascending: true }),
            ]);

            const [{ data: products, error: pErr }, { data: categories, error: cErr }] = await withTimeout(fetchPromise, DATA_TIMEOUT_MS);

            if (pErr) throw pErr;
            if (cErr) throw cErr;

            this.allProducts = (products || []).map((p) => ({
              ...p,
              category: p.category_name,
              barcode: p.barcode ? String(p.barcode) : null,
              _imgError: false,
            }));
            this.allCategories = categories || [];
            this.lastSynced = new Date();

            this.buildFuseIndex();
            this.cacheData();
            this.loading = false;
            this.runSearch();
          } catch (err) {
            console.error("Gagal memuat data dari Supabase:", err);
            const usedCache = this.loadFromCache();
            if (!usedCache) {
              this.scanNotice = "Gagal memuat data. Periksa konfigurasi Supabase & koneksi internet.";
            }
            this.loading = false;
          }
        },

        // ---- caching ----
        cacheData() {
          try {
            localStorage.setItem(CACHE_KEY, JSON.stringify({
              products: this.allProducts, categories: this.allCategories, syncedAt: this.lastSynced.toISOString(),
            }));
          } catch (e) { /* penuh/tidak tersedia — abaikan */ }
        },

        loadFromCache() {
          try {
            const raw = localStorage.getItem(CACHE_KEY);
            if (!raw) return false;
            const cached = JSON.parse(raw);
            this.allProducts = (cached.products || []).map((p) => ({ ...p, _imgError: false }));
            this.allCategories = cached.categories || [];
            this.lastSynced = cached.syncedAt ? new Date(cached.syncedAt) : null;
            this.buildFuseIndex();
            this.runSearch();
            return true;
          } catch (e) { return false; }
        },

        buildFuseIndex() {
          this.fuse = new Fuse(this.allProducts, {
            keys: [
              { name: "name", weight: 0.70 },
              { name: "alias", weight: 0.30 }
            ],
            threshold: 0.35, ignoreLocation: true, minMatchCharLength: 2,
          });
        },

        // ---- search & filter ----
        runSearch() {
          this.isScanResult = false;
          const q = this.query.trim();
          if (q.length > 0) {
            this.selectedCategory = null;
            // Barcode prefix match (strict, no fuzzy)
            const barcodeResults = q.match(/^\d+$/)
              ? this.allProducts.filter((p) => p.barcode && String(p.barcode).startsWith(q))
              : [];
            // Fuse search for name/alias only
            const fuseResults = this.fuse ? this.fuse.search(q).map((r) => r.item) : [];
            // Merge results: barcode prefix match first, then unique fuse results
            const barcodeSet = new Set(barcodeResults.map((p) => p.id));
            const merged = [...barcodeResults, ...fuseResults.filter((p) => !barcodeSet.has(p.id))];
            this.results = merged.slice(0, 30);
          } else if (this.selectedCategory && this.selectedCategory.id !== 0) {
            this.results = this.allProducts.filter((p) => p.category_id === this.selectedCategory.id);
          } else {
            this.results = this.allProducts;
          }
          this.syncHistoryState();
        },

        resetViewState() {
          this.query = "";
          this.selectedCategory = null;
          this.isScanResult = false;
          this.results = this.allProducts;
        },

        syncHistoryState() {
          const active = this.isSearchActive;
          const top = this._nav[this._nav.length - 1];
          if (active && top !== "browsing") {
            this.navPush("browsing");
          } else if (!active && top === "browsing") {
            history.back();
          }
        },

        goHome() {
          this.resetViewState();
          if (this._nav[this._nav.length - 1] === "browsing") {
            history.back();
          }
        },

        selectCategory(cat) {
          if (this.selectedCategory && this.selectedCategory.id === cat.id) { this.clearCategory(); return; }
          this.query = "";
          this.selectedCategory = cat;
          this.runSearch();
        },
        clearCategory() { this.selectedCategory = null; this.runSearch(); },
        clearSearch() { this.query = ""; this.runSearch(); this.$refs.searchInput.focus(); },

        setViewMode(mode) {
          this.viewMode = mode;
          try { localStorage.setItem(VIEW_MODE_KEY, mode); } catch (e) {}
        },

        // ---- zoom foto ----
        openZoom(p) {
          if (!p || !p.image_url || p._imgError) return;
          this.zoomedProduct = p;
          this.navPush("zoom");
        },
        closeZoom() {
          this.zoomedProduct = null;
          if (this._nav[this._nav.length - 1] === "zoom") {
            history.back();
          }
        },

        // ---- detail produk ----
        openProductDetail(p) {
          if (!p) return;
          this.selectedProduct = p;
          this.navPush("detail");
        },
        closeProductDetail() {
          this.selectedProduct = null;
          if (this._nav[this._nav.length - 1] === "detail") {
            history.back();
          }
        },

        // ---- barcode scanner ----
        scanBarcode() {
          this.scannerOpen = true;
          this.scannerState = "starting";
          this.isProcessingScan = false;
          this.navPush("scanner");
          this.$nextTick(() => this.startCamera());
        },

        startCamera() {
          this.scannerState = "starting";
          if (typeof Html5Qrcode === "undefined") { this.scannerState = "camera-error"; return; }

          const mountScanner = () => {
            this.html5QrCode = new Html5Qrcode("qr-reader", { verbose: false });
            const config = { fps: 10, qrbox: { width: 250, height: 150 }, aspectRatio: 1.4 };

            this.html5QrCode
              .start({ facingMode: "environment" }, config,
                (decodedText) => this.handleScanSuccess(decodedText),
                () => {})
              .then(() => { this.scannerState = "active"; })
              .catch((err) => { console.error("Gagal membuka kamera:", err); this.scannerState = "camera-error"; });
          };

          if (this.html5QrCode) {
            this.html5QrCode.stop().catch(() => {}).finally(() => { this.html5QrCode = null; mountScanner(); });
          } else {
            mountScanner();
          }
        },

        async handleScanSuccess(decodedText) {
          if (this.isProcessingScan) return;
          this.isProcessingScan = true;
          if (this.html5QrCode) { try { await this.html5QrCode.pause(true); } catch (e) {} }
          this.playBeep();

          const barcode = decodedText.trim();
          const product = this.allProducts.find((p) => p.barcode === barcode);
          if (product) { this.showScannedProduct(product); }
          else { this.lastScannedBarcode = barcode; this.scannerState = "not-found"; this.isProcessingScan = false; }
        },

        showScannedProduct(product) {
          this.query = ""; this.selectedCategory = null; this.isScanResult = true;
          this.results = [product];
          this.closeScannerInternal();

          const top = this._nav[this._nav.length - 1];
          const below = this._nav[this._nav.length - 2];
          if (top === "scanner" && below === "browsing") {
            history.back();
          } else if (top === "scanner") {
            this.navReplace("browsing");
          } else {
            this.syncHistoryState();
          }
        },

        resumeScanning() {
          this.scannerState = "active"; this.isProcessingScan = false;
          if (this.html5QrCode) { try { this.html5QrCode.resume(); } catch (e) { this.startCamera(); } }
          else { this.startCamera(); }
        },

        goToManualSearch() {
          const barcode = this.lastScannedBarcode;
          this.closeScanner();
          this.$nextTick(() => {
            this.$refs.searchInput.focus();
            if (barcode) {
              this.scanNotice = `Barcode ${barcode} tidak terdaftar. Silakan cari manual via nama produk.`;
              setTimeout(() => { this.scanNotice = ""; }, 4500);
            }
          });
        },

        closeScannerInternal() {
          this.scannerOpen = false; this.scannerState = "idle"; this.isProcessingScan = false;
          if (this.html5QrCode) {
            this.html5QrCode.stop().catch(() => {}).finally(() => { this.html5QrCode.clear(); this.html5QrCode = null; });
          }
        },

        closeScanner() {
          this.closeScannerInternal();
          if (this._nav[this._nav.length - 1] === "scanner") {
            history.back();
          }
        },

        playBeep() {
          try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = ctx.createOscillator();
            const gain = ctx.createGain();
            oscillator.type = "sine"; oscillator.frequency.value = 1200;
            gain.gain.setValueAtTime(0.15, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
            oscillator.connect(gain); gain.connect(ctx.destination);
            oscillator.start(); oscillator.stop(ctx.currentTime + 0.15);
          } catch (e) {}
        },

        // ---- helpers ----
        getIcon(iconName, isActive, size) {
          const path = ICONS[iconName] || DEFAULT_ICON;
          const stroke = isActive ? "white" : "var(--ink-faint)";
          const s = size || 22;
          return `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${stroke}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;
        },

        formatRupiah(value) {
          if (value === null || value === undefined) return "-";
          return new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0 }).format(value);
        },

        get quickAccessCategories() { return this.allCategories.filter((c) => c.is_quick_access); },
        get isSearchActive() { return this.query.trim().length > 0 || this.selectedCategory !== null || this.isScanResult; },
        get resultsLabel() {
          if (this.isScanResult) return "Hasil scan barcode";
          if (this.selectedCategory) return `${this.results.length} barang di "${this.selectedCategory.name}"`;
          return `${this.results.length} hasil untuk "${this.query}"`;
        },
        get isDataStale() {
          this._staleCheck; // Force dependency tracking untuk reactivity update
          if (!this.lastSynced) return false;
          const now = new Date();
          const diff = now - this.lastSynced;
          return diff >= STALE_THRESHOLD_MS;
        },
        get lastSyncedLabel() {
          if (!this.lastSynced) return "Belum tersinkron";
          const time = this.lastSynced.toLocaleTimeString("id-ID", { hour: "2-digit", minute: "2-digit" });
          const stale = this.isDataStale ? " · mungkin usang" : "";
          return `Data terakhir: ${time}${stale}`;
        },

        destroy() {
          if (this._staleInterval) {
            clearInterval(this._staleInterval);
            this._staleInterval = null;
          }
        },
      };
    }

    // ---- Registrasi Service Worker (PWA offline caching) ----
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", () => {
        navigator.serviceWorker.register("./sw.js").catch((err) => console.warn("Registrasi service worker gagal:", err));
      });
    }
  </script>
