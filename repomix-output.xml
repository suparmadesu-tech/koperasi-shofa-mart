<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no" />
<title>Katalog Koperasi — Cek Harga</title>

<!-- PWA -->
<link rel="manifest" href="./manifest.json" />
<meta name="theme-color" content="#0C4A6E" />
<link rel="apple-touch-icon" href="./icons/icon-192.png" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Shofa Mart" />

<!-- Tailwind CSS (CDN) → Production build -->
<link rel="stylesheet" href="./styles.css" />

<!-- Alpine.js (CDN) -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>

<!-- Fuse.js (CDN) — fuzzy search client-side -->
<script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>

<!-- Supabase JS client (CDN) -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>

<!-- html5-qrcode (CDN) — barcode/QR scanner via kamera -->
<script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<style>
  :root{
    /* Backgrounds & Surface */
    --bg:            #F4F8FA;
    --surface:       #FFFFFF;
    --surface-sunken:#EEF4F7;
    --surface-raised:#FFFFFF;

    /* Typography & Ink */
    --ink:           #0F172A;
    --ink-muted:     #64748B;
    --ink-faint:     #94A3B8;

    /* Borders & Dividers */
    --border:        #E2E8F0;
    --border-strong: #CBD5E1;

    /* Brand Primary: SHОFA MART OCEAN */
    --primary:       #075985;
    --primary-dark:  #0C4A6E;
    --primary-light: #0284C7;
    --primary-tint:  #E0F2FE;

    /* Accent: restrained warm gold */
    --accent:        #F59E0B;
    --accent-dark:   #B45309;
    --accent-tint:   #FEF3C7;

    /* Semantic States */
    --online:        #1E9E5A;
    --offline:       #B45309;
    --success:       #1E9E5A;
    --success-tint:  #E6F7EE;
    --warning:       #D97706;
    --warning-tint:  #FEF3E2;
    --danger:        #B42318;
    --danger-tint:   #FBEAE8;
  }

  * { -webkit-tap-highlight-color: transparent; }

  html, body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  [x-cloak] { display: none !important; }

  @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .dot-online { animation: pulse-dot 2.4s ease-in-out infinite; }

  /* Signature Card v5.1: Refined depth */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow:
      0 1px 3px rgba(15, 23, 42, 0.06),
      0 4px 12px rgba(15, 23, 42, 0.04);
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 220ms ease-out;
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: #BAE6FD;
    box-shadow:
      0 4px 8px rgba(7, 89, 133, 0.08),
      0 12px 24px -4px rgba(7, 89, 133, 0.12);
  }
  .card:active {
    transform: translateY(-1px) scale(0.995);
  }
  .card:focus-within {
    outline: 2px solid var(--primary-light);
    outline-offset: 2px;
  }

  /* Photo area: Ocean signature with refined depth */
  .photo-area {
    background: linear-gradient(145deg, #F0F9FF 0%, #E0F2FE 100%);
    position: relative;
  }
  .photo-area::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(7, 89, 133, 0.08);
    pointer-events: none;
  }

  /* Button active */
  .btn-interactive { transition: transform 150ms ease, background-color 150ms ease; }
  .btn-interactive:active { transform: scale(0.96); }

  /* Price highlight */
  .price-highlight { color: var(--primary-dark); font-weight: 800; }

  /* Tabular numbers */
  .tabular { font-variant-numeric: tabular-nums; }

  /* Ocean subtle background */
  .bg-ocean-subtle {
    background-image:
      radial-gradient(at 0% 0%, rgba(2, 132, 199, 0.06) 0px, transparent 50%),
      radial-gradient(at 100% 0%, rgba(20, 184, 166, 0.05) 0px, transparent 50%);
  }

  /* Skeleton shimmer */
  .skeleton {
    position: relative;
    overflow: hidden;
    background: var(--surface-sunken);
  }
  .skeleton::after {
    content: "";
    position: absolute; inset: 0;
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.7), transparent);
    animation: shimmer 1.6s ease-in-out infinite;
  }
  @keyframes shimmer { 100% { transform: translateX(100%); } }

  /* Scanner styles */
  #qr-reader { width: 100%; border-radius: 16px; overflow: hidden; background: #000; }
  #qr-reader video { width: 100% !important; border-radius: 16px; object-fit: cover; }
  #qr-reader__scan_region { border-radius: 16px !important; }
  #qr-reader__dashboard { display: none !important; }

  /* Category chips scroll */
  .category-chip {
    transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }
  .category-chip.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(7,89,133,0.22);
  }
  .category-chip.inactive {
    background: var(--surface);
    color: var(--ink-muted);
    border-color: var(--border);
  }

  /* Category icon active/inactive */
  .cat-icon-active { color: white !important; }
  .cat-icon-inactive { color: var(--ink-faint) !important; }
</style>
</head>

<body class="min-h-screen bg-[var(--bg)]" x-data="kasirApp()" x-init="init()">
  <!-- =========================================================
       HEADER
  ========================================================== -->
  <header class="sticky top-0 z-30 bg-white/90 backdrop-blur border-b border-[var(--border)] shadow-sm">
    <div class="max-w-md lg:max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="relative w-9 h-9 rounded-xl overflow-hidden ring-1 ring-[var(--border)]">
          <img src="icons/icon-192.png" alt="Logo Shofa Mart" class="w-full h-full object-cover">
        </div>
        <div class="leading-tight min-w-0">
          <p class="font-bold text-[15px] text-[var(--ink)] truncate">Shofa Mart</p>
          <p class="text-[10.5px] truncate" :class="isDataStale ? 'text-[var(--warning)]' : 'text-[var(--ink-muted)]'" x-text="lastSyncedLabel"></p>
        </div>
      </div>

      <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full"
           :class="online ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-amber-50 text-amber-700 border border-amber-100'">
        <span class="w-2 h-2 rounded-full" :class="online ? 'bg-emerald-500 dot-online' : 'bg-amber-500'"></span>
        <span class="text-[10px] font-semibold" x-text="online ? 'Online' : 'Offline'"></span>
      </div>
    </div>
  </header>

  <main class="max-w-md lg:max-w-5xl mx-auto px-4 pb-10">

    <!-- =========================================================
         HERO / SEARCH AREA
    ========================================================== -->
    <section class="pt-4 space-y-3">
      <div class="text-center space-y-1">
        <h1 class="text-[18px] font-extrabold text-[var(--ink)] tracking-tight">Katalog Harga</h1>
        <p class="text-[12px] text-[var(--ink-muted)] font-medium">Cari barang & cek harga dengan cepat</p>
      </div>

      <div class="relative group">
        <div class="absolute left-3.5 top-1/2 -translate-y-1/2">
          <svg class="text-[var(--ink-faint)]" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <input
          type="text" inputmode="search" x-ref="searchInput" x-model="query"
          @input.debounce.150ms="runSearch()"
          placeholder="Cari nama barang atau scan barcode..."
          class="w-full pl-11 pr-12 py-3.5 rounded-2xl border border-[var(--border)] bg-[var(--surface)] shadow-sm text-[15px] placeholder:text-[var(--ink-faint)] focus:outline-none focus:ring-2 focus:ring-[var(--primary-light)]/40 focus:border-[var(--primary)] transition-all"
        />
        <button x-show="query.length > 0" x-cloak @click="clearSearch()"
                class="absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full hover:bg-[var(--surface-sunken)] text-[var(--ink-muted)] flex items-center justify-center transition-colors" aria-label="Hapus pencarian">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="flex items-center gap-2">
        <button @click="scanBarcode()" x-cloak
                class="flex-1 flex items-center justify-center gap-2 py-3.5 rounded-2xl bg-[var(--surface)] border border-[var(--primary)]/20 text-[var(--primary-dark)] font-semibold shadow-sm transition-all hover:bg-[var(--primary-tint)]/40 active:scale-[0.98]"
                aria-label="Scan barcode">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="7" y1="12" x2="17" y2="12"/></svg>
          <span class="text-[14px]">Scan</span>
        </button>
      </div>

      <p x-show="scanNotice" x-cloak x-transition class="text-[11.5px] text-[var(--accent-dark)] bg-[var(--accent-tint)]/60 border border-[var(--accent)]/20 rounded-xl px-3 py-2">
        <span x-text="scanNotice"></span>
      </p>
    </section>

    <!-- =========================================================
         CATEGORY QUICK ACCESS
    ========================================================== -->
    <section x-show="!isScanResult && query.trim().length === 0" x-cloak class="pt-2">
      <div class="flex items-center justify-between mb-2.5">
        <p class="text-[13px] font-bold text-[var(--ink-muted)]">Kategori</p>
      </div>

      <div class="relative">
        <div class="flex gap-2 pb-1 overflow-x-auto no-scrollbar">
          <!-- All category chip -->
          <button @click="goHome()" :class="!selectedCategory ? 'active' : 'inactive'"
                  class="category-chip px-3.5 py-1.5 rounded-xl border text-[12px] font-semibold flex items-center gap-1.5 shadow-sm shrink-0">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 11 4-6"/><path d="m19 11-4-6"/><path d="M2 11h20l-1.6 8.2a2 2 0 0 1-2 1.8H5.6a2 2 0 0 1-2-1.8L2 11Z"/><path d="M12 16v-3"/></svg>
            <span>Semua</span>
          </button>

          <template x-if="loading">
            <template x-for="i in 6" :key="i">
              <div class="category-chip w-20 py-2 rounded-xl skeleton shrink-0"></div>
            </template>
          </template>

          <template x-for="cat in quickAccessCategories" :key="cat.id">
            <button @click="selectCategory(cat)" :class="selectedCategory && selectedCategory.id === cat.id ? 'active' : 'inactive'"
                    class="category-chip px-3.5 py-1.5 rounded-xl border text-[12px] font-semibold flex items-center gap-1.5 shadow-sm shrink-0">
              <span :class="selectedCategory && selectedCategory.id === cat.id ? 'cat-icon-active' : 'cat-icon-inactive'" x-html="getIcon(cat.icon, false, 13)"></span>
              <span x-text="cat.name"></span>
            </button>
          </template>
        </div>
      </div>

      <div x-show="selectedCategory && selectedCategory.id !== 0" x-cloak class="mt-3">
        <button @click="clearCategory()" class="flex items-center gap-1.5 text-[12.5px] font-semibold text-[var(--primary-dark)]">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
          <span>Hapus filter kategori</span>
        </button>
      </div>
    </section>

    <!-- =========================================================
         RESULTS HEADER + COUNT
    ========================================================== -->
    <section class="pt-3 flex items-center justify-between">
      <div class="flex items-center gap-2 min-w-0">
        <button x-show="isSearchActive" x-cloak @click="goHome()"
                class="w-8 h-8 rounded-xl bg-[var(--surface-sunken)] flex items-center justify-center shrink-0 transition-colors" aria-label="Kembali ke beranda">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--primary-dark)" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        </button>
        <p class="text-[13.5px] font-bold text-[var(--ink)]" x-text="isSearchActive ? resultsLabel : 'Semua produk'"></p>
      </div>

      <!-- View toggle -->
      <div class="flex items-center gap-1 p-1 rounded-xl bg-[var(--surface-sunken)]">
