    --offline:       #F59E0B;
    --success:       #16A34A;
    --success-tint:  #DCFCE7;
    --warning:       #D97706;
    --warning-tint:  #FEF3E2;
    --danger:        #DC2626;
    --danger-tint:   #FEE2E2;

    /* Elevational Shadows */
    --shadow-card:   0 1px 2px rgba(15,23,42,0.04), 0 4px 14px rgba(15,23,42,0.05);
    --shadow-sm:     0 1px 2px rgba(15,23,42,0.04);
    --shadow-md:     0 2px 4px rgba(15,23,42,0.06), 0 4px 12px rgba(15,23,42,0.08);
    --shadow-lg:     0 4px 8px rgba(15,23,42,0.08), 0 8px 24px rgba(15,23,42,0.12);
  }

  html, body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  [x-cloak] { display: none !important; }

  table { border-collapse: collapse; }
  tbody tr { transition: background-color 150ms ease, opacity 150ms ease; }
  tbody tr:hover { background: #F8FBFD; }
  .admin-input {
    width: 100%;
    padding: 0.55rem 0.75rem;
    border-radius: 0.6rem;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 13.5px;
  }
  .admin-input:focus { outline: none; box-shadow: 0 0 0 2px var(--primary); border-color: transparent; }
  .admin-label { font-size: 12.5px; font-weight: 500; color: var(--ink-muted); margin-bottom: 0.3rem; display: block; }
  .admin-nav-item { display: flex; align-items: center; min-height: 44px; padding: 0.65rem 0.75rem; border-radius: 0.7rem; color: #94A3B8; font-size: 13px; font-weight: 600; text-decoration: none; transition: all 150ms ease; }
  .admin-nav-item:hover { background: rgba(7, 89, 133, 0.15); color: #E0F2FE; }
  .admin-nav-active { background: linear-gradient(135deg, #075985 0%, #0284C7 100%); color: white; box-shadow: 0 2px 8px rgba(7, 89, 133, 0.3); }

  /* Button hierarchy */
  .btn-primary { padding: 0.6rem 1.1rem; border-radius: 0.75rem; background: var(--primary); color: white; font-size: 13px; font-weight: 600; border: none; cursor: pointer; transition: all 150ms ease; box-shadow: 0 1px 3px rgba(7, 89, 133, 0.2); }
  .btn-primary:hover:not(:disabled) { background: var(--primary-dark); box-shadow: 0 2px 6px rgba(7, 89, 133, 0.3); transform: translateY(-1px); }
  .btn-primary:active:not(:disabled) { transform: translateY(0); }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

  .btn-secondary { padding: 0.6rem 1.1rem; border-radius: 0.75rem; background: var(--surface); color: var(--ink); font-size: 13px; font-weight: 500; border: 1px solid var(--border-strong); cursor: pointer; transition: all 150ms ease; }
  .btn-secondary:hover:not(:disabled) { background: var(--surface-sunken); border-color: var(--ink-muted); box-shadow: var(--shadow-sm); }

  .btn-ghost { padding: 0.6rem 1.1rem; border-radius: 0.75rem; background: transparent; color: var(--ink-muted); font-size: 13px; font-weight: 500; border: 1px solid var(--border); cursor: pointer; transition: all 150ms ease; }
  .btn-ghost:hover:not(:disabled) { background: var(--surface-sunken); color: var(--ink); border-color: var(--border-strong); }

  .btn-danger { padding: 0.55rem 1rem; border-radius: 0.75rem; background: transparent; color: var(--danger); font-size: 13px; font-weight: 500; border: 1px solid var(--danger); cursor: pointer; transition: all 150ms ease; }
  .btn-danger:hover:not(:disabled) { background: var(--danger); color: white; box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25); }

  .btn-sm { padding: 0.35rem 0.65rem; font-size: 11.5px; border-radius: 0.5rem; }

  .form-section-title { font-size: 11.5px; font-weight: 700; color: var(--primary-dark); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.85rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--primary-tint); }

  @media (max-width: 640px) {
    .price-row-grid { display: flex; flex-direction: column; gap: 0.5rem; }
    .price-row-grid input { width: 100%; }
    .price-row-grid button { align-self: flex-end; }
  }
</style>
</head>

<body class="min-h-screen bg-[var(--bg)]" x-data="adminApp()" x-init="init()">

  <!-- =========================================================
       LOGIN VIEW
  ========================================================== -->
  <div x-show="!session" x-cloak class="min-h-screen flex items-center justify-center px-4 bg-gradient-to-br from-slate-50 via-blue-50 to-cyan-50">
    <div class="w-full max-w-sm">
      <div class="text-center mb-7">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#075985] to-[#0284C7] mx-auto flex items-center justify-center mb-4 shadow-xl shadow-[#075985]/30">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-6 9 6"/><path d="M5 10v9a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1v-9"/></svg>
        </div>
        <h1 class="text-[20px] font-bold text-[var(--ink)] tracking-tight">Admin Shofa Mart</h1>
        <p class="text-[13.5px] text-[var(--ink-muted)] mt-1.5">Masuk untuk mengelola katalog koperasi</p>
      </div>

      <form @submit.prevent="login()" class="bg-[var(--surface)] border border-[var(--border)] rounded-2xl p-5 space-y-3.5 shadow-xl">
        <div>
          <label class="admin-label">Email</label>
          <input type="email" x-model="loginEmail" required autocomplete="username" class="admin-input" placeholder="admin@shofamart.id" />
        </div>
        <div>
          <label class="admin-label">Password</label>
          <input type="password" x-model="loginPassword" required autocomplete="current-password" class="admin-input" placeholder="••••••••" />
        </div>

        <p x-show="loginError" x-cloak class="text-[12.5px] text-[var(--danger)] bg-[var(--danger-tint)] rounded-lg px-3 py-2 border border-[var(--danger)]/20" x-text="loginError"></p>

        <button type="submit" :disabled="loginLoading"
                class="w-full py-2.5 rounded-xl bg-gradient-to-r from-[#075985] to-[#0284C7] text-white font-semibold text-[14px] disabled:opacity-60 shadow-lg shadow-[#075985]/25 hover:shadow-xl hover:shadow-[#075985]/30 transition-all">
          <span x-show="!loginLoading">Masuk</span>
          <span x-show="loginLoading" x-cloak>Memproses…</span>
        </button>
      </form>
    </div>
  </div>

  <!-- =========================================================
       DASHBOARD VIEW
  ========================================================== -->
  <div x-show="session" x-cloak>

    <!-- Desktop sidebar / mobile navigation -->
    <aside class="admin-sidebar hidden md:flex fixed inset-y-0 left-0 z-20 w-60 flex-col bg-slate-900 text-white border-r border-slate-800 p-5 shadow-xl">
      <div class="flex items-center gap-2.5 mb-8">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#075985] to-[#0284C7] flex items-center justify-center shrink-0 shadow-lg shadow-[#075985]/40">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-6 9 6"/><path d="M5 10v9a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1 1v-9"/></svg>
        </div>
        <div><p class="font-bold text-[15px] tracking-tight text-white">Shofa Mart</p><p class="text-[11px] text-slate-400">Admin Katalog</p></div>
      </div>
      <nav class="space-y-1" aria-label="Navigasi admin">
        <a href="#produk" class="admin-nav-item admin-nav-active">Produk</a>
        <button type="button" @click="masterModalOpen = true" class="admin-nav-item w-full text-left">Master Produk</button>
      </nav>
      <div class="mt-auto pt-5 border-t border-slate-800">
        <button type="button" @click="logout()" class="admin-nav-item w-full text-left text-rose-300 hover:bg-rose-950/30">Keluar</button>
      </div>
    </aside>

    <div x-show="mobileMenuOpen" x-cloak class="fixed inset-0 z-40 md:hidden" @click="mobileMenuOpen = false">
      <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
      <aside class="relative w-72 max-w-[85vw] h-full bg-slate-900 text-white p-5 shadow-2xl border-r border-slate-800" @click.stop>
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#075985] to-[#0284C7] flex items-center justify-center shrink-0 shadow-lg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-6 9 6"/><path d="M5 10v9a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1v-9"/></svg>
            </div>
            <div><p class="font-bold text-[14px] text-white">Shofa Mart</p><p class="text-[11px] text-slate-400">Admin Katalog</p></div>
          </div>
          <button type="button" @click="mobileMenuOpen = false" class="w-11 h-11 rounded-xl hover:bg-slate-800 text-slate-300 flex items-center justify-center text-2xl" aria-label="Tutup menu">×</button>
        </div>
        <nav class="space-y-1" aria-label="Navigasi admin mobile">
          <a href="#produk" @click="mobileMenuOpen = false" class="admin-nav-item admin-nav-active">Produk</a>
          <button type="button" @click="masterModalOpen = true; mobileMenuOpen = false" class="admin-nav-item w-full text-left">Master Produk</button>
        </nav>
      </aside>
    </div>

    <header id="produk" class="sticky top-0 z-30 md:ml-60 bg-slate-900 text-white border-b border-slate-800 shadow-sm">
      <div class="max-w-6xl mx-auto px-5 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <button type="button" @click="mobileMenuOpen = true" class="md:hidden w-11 h-11 -ml-2 rounded-xl hover:bg-slate-800 text-slate-200" aria-label="Buka menu">☰</button>
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#075985] to-[#0284C7] flex items-center justify-center shrink-0 shadow-md">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-6 9 6"/><path d="M5 10v9a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1v-9"/></svg>
          </div>
          <p class="font-semibold text-[14.5px] text-white">Admin — Shofa Mart</p>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-[12.5px] text-slate-400 hidden sm:inline" x-text="session?.user?.email"></span>
          <button @click="logout()" class="text-[12.5px] font-medium px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/80 hover:bg-slate-800 text-slate-200 transition-colors">Keluar</button>
        </div>
      </div>
    </header>

    <main class="md:ml-60 max-w-6xl mx-auto px-5 py-5">

      <!-- Dashboard summary -->
      <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5" aria-label="Ringkasan admin">
        <template x-for="stat in [
          { label: 'Produk Aktif', value: activeProductCount, icon: '✓', tone: 'text-emerald-600', bg: 'bg-emerald-50' },
          { label: 'Produk Nonaktif', value: inactiveProductCount, icon: '○', tone: 'text-amber-600', bg: 'bg-amber-50' },
          { label: 'Total Master Produk', value: masterProductCount, icon: '▦', tone: 'text-[#075985]', bg: 'bg-[#E4F0F7]' },
          { label: 'Total Kategori', value: categoryCount, icon: '⌘', tone: 'text-[#B45309]', bg: 'bg-[#FEF3C7]' }
        ]" :key="stat.label">
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-raised)] p-3.5 shadow-[var(--shadow-sm)] min-h-[94px]">
            <div class="flex items-start justify-between gap-2">
              <p class="text-[11.5px] leading-4 text-[var(--ink-muted)]" x-text="stat.label"></p>
              <span class="text-lg leading-none font-bold" :class="stat.tone" x-text="stat.icon" aria-hidden="true"></span>
            </div>
            <template x-if="statsLoading">
              <div class="mt-3 h-7 w-16 rounded-md bg-[var(--surface-sunken)] animate-pulse" aria-label="Memuat statistik"></div>
            </template>
            <strong x-show="!statsLoading" class="block mt-2 text-2xl leading-none tracking-tight text-[var(--ink)] font-bold" x-text="stat.value.toLocaleString('id-ID')"></strong>
          </div>
        </template>
      </section>

      <!-- Toolbar -->
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <input
          type="text"
          x-model="search"
          @input.debounce.200ms="applyFilters()"
          placeholder="Cari nama, alias, atau barcode…"
          class="admin-input flex-1 min-w-[200px]"
        />
        <select x-model="filterCategory" @change="applyFilters()" class="admin-input w-auto">
          <option value="">Semua Kategori</option>
          <template x-for="cat in allCategories" :key="cat.id">
            <option :value="cat.id" x-text="cat.name"></option>
          </template>
        </select>
        <select x-model="filterStatus" @change="applyFilters()" class="admin-input w-auto">
          <option value="">Semua Status</option>
          <option value="active">Aktif</option>
          <option value="inactive">Nonaktif</option>
        </select>

        <div class="flex-1 flex justify-end">
          <button @click="masterModalOpen = true" class="btn-secondary">
            Database Master Produk
          </button>
        </div>

        <button @click="openAddModal()" class="btn-primary">
          + Tambah Produk
        </button>
        <button @click="$refs.csvFileInput.click()" class="btn-secondary">
          Import CSV
        </button>
        <input type="file" x-ref="csvFileInput" accept=".csv" class="hidden" @change="handleCsvFile($event)" />
        <button @click="exportCsv()" class="btn-ghost">
          Export CSV
        </button>
        <button @click="downloadTemplate()" class="btn-ghost">
          Unduh Template CSV
        </button>
      </div>

      <!-- Table -->
      <div class="border border-[var(--border)] rounded-2xl overflow-hidden bg-[var(--surface)] shadow-[var(--shadow-card)]">
        <div class="overflow-x-auto">
          <table class="w-full text-[13px]">
            <thead>
              <tr class="bg-[#F1F8FC] text-left text-[11.5px] uppercase tracking-wide text-[var(--primary-dark)] border-b border-[var(--border)]">
                <th class="px-4 py-2.5 font-medium">Nama</th>
                <th class="px-4 py-2.5 font-medium">Kategori</th>
                <th class="px-4 py-2.5 font-medium">Barcode</th>
                <th class="px-4 py-2.5 font-medium">Satuan & Harga</th>
                <th class="px-4 py-2.5 font-medium">Rak</th>
                <th class="px-4 py-2.5 font-medium">Stok</th>
                <th class="px-4 py-2.5 font-medium">Status</th>
                <th class="px-4 py-2.5 font-medium">Diperbarui</th>
                <th class="px-4 py-2.5 font-medium">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <template x-if="loading">
                <tr><td colspan="9" class="px-4 py-8 text-center text-[var(--ink-muted)]">Memuat data…</td></tr>
              </template>

              <template x-if="!loading && pagedProducts.length === 0">
                <tr><td colspan="9" class="px-4 py-8 text-center text-[var(--ink-muted)]">Tidak ada produk yang cocok.</td></tr>
              </template>

              <template x-for="p in pagedProducts" :key="p.id">
                <tr class="border-t border-[var(--border)] align-top" :class="!p.is_active && 'opacity-55'">
                  <td class="px-4 py-2.5">
                    <div class="flex items-center gap-2.5">
                      <div class="w-9 h-9 rounded-lg overflow-hidden bg-[var(--surface-sunken)] shrink-0 flex items-center justify-center">
                        <img x-show="p.image_url && !p._imgError" :src="p.image_url" @error="p._imgError = true" class="w-full h-full object-cover" />
                        <svg x-show="!p.image_url || p._imgError" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9AA6A0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10.5" r="1.5"/><path d="m21 15-5-5L5 19"/></svg>
                      </div>
                      <div class="min-w-0">
                        <p class="font-medium text-[var(--ink)] truncate" x-text="p.name"></p>
                        <p x-show="p.alias && p.alias.length" class="text-[11.5px] text-[var(--ink-muted)] truncate" x-text="(p.alias||[]).join(', ')"></p>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-2.5">
                    <span class="text-[11.5px] px-2 py-0.5 rounded-full bg-[var(--surface-sunken)]" x-text="categoryName(p)"></span>
                  </td>
                  <td class="px-4 py-2.5 font-mono text-[12px]" x-text="p.barcode || '-'"></td>
                  <td class="px-4 py-2.5">
                    <template x-for="row in p.prices" :key="row.unit">
                      <div class="whitespace-nowrap">
                        <span class="text-[var(--ink-muted)]" x-text="'per ' + row.unit + ': '"></span>
                        <span class="font-medium" x-text="formatRupiah(row.price_public)"></span>
                        <span x-show="row.price_member !== row.price_public" class="text-[11px] text-[var(--primary-dark)]" x-text="' (Ang: ' + formatRupiah(row.price_member) + ')'"></span>
                      </div>
                    </template>
                  </td>
                  <td class="px-4 py-2.5" x-text="p.location_shelf || '-'"></td>
                  <td class="px-4 py-2.5" x-text="p.stock ?? '-'"></td>
                  <td class="px-4 py-2.5">
                    <span class="text-[11px] font-medium px-2 py-0.5 rounded-full"
                          :class="p.is_active ? 'bg-[var(--primary-tint)] text-[var(--primary-dark)]' : 'bg-[var(--surface-sunken)] text-[var(--ink-muted)]'"
                          x-text="p.is_active ? 'Aktif' : 'Nonaktif'"></span>
                  </td>
                  <td class="px-4 py-2.5 text-[11.5px] text-[var(--ink-muted)]">
                    <p x-text="formatDate(p.updated_at)"></p>
                    <p x-show="p.updated_by" x-text="p.updated_by"></p>
                  </td>
                  <td class="px-4 py-2.5">
                    <div class="flex flex-col gap-1.5">
                      <button @click="openEditModal(p)" class="btn-secondary btn-sm text-center">Edit</button>
                      <button @click="toggleActive(p)" class="btn-sm text-center"
                              :class="p.is_active ? 'btn-danger' : 'btn-primary'"
                              x-text="p.is_active ? 'Nonaktifkan' : 'Aktifkan'"></button>
                    </div>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination -->
      <div class="flex flex-wrap items-center justify-between gap-2 mt-3.5 text-[12.5px] text-[var(--ink-muted)]">
        <p x-text="paginationLabel"></p>
        <div class="flex items-center gap-2">
          <button @click="prevPage()" :disabled="page <= 1" class="btn-ghost btn-sm disabled:opacity-40">Sebelumnya</button>
          <span class="font-medium text-[var(--primary-dark)]" x-text="`Halaman ${page} / ${totalPages}`"></span>
          <button @click="nextPage()" :disabled="page >= totalPages" class="btn-ghost btn-sm disabled:opacity-40">Berikutnya</button>
        </div>
      </div>
    </main>
  </div>

  <!-- =========================================================
       MODAL: TAMBAH / EDIT PRODUK
  ========================================================== -->
  <div x-show="productModalOpen" x-cloak class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-[var(--surface)] rounded-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
      <div class="px-5 pt-5 pb-3 border-b border-[var(--border)] flex items-center justify-between sticky top-0 bg-[var(--surface)]">
        <h2 class="text-[15.5px] font-semibold" x-text="editingProduct && editingProduct.id ? 'Edit Produk' : 'Tambah Produk'"></h2>
        <button @click="closeProductModal()" class="w-7 h-7 rounded-full bg-[var(--surface-sunken)] flex items-center justify-center">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
        </button>
      </div>

      <form @submit.prevent="saveProduct()" class="px-5 py-4 space-y-3.5" x-show="editingProduct">
        <input type="hidden" x-model="editingProduct.master_product_id" />

        <section class="border border-[var(--border)] rounded-xl p-3.5 space-y-3">
          <h3 class="form-section-title">Informasi Produk</h3>
          <div>
          <label class="admin-label">Nama Produk *</label>
          <input type="text" x-model="editingProduct.name" required class="admin-input" placeholder="mis. Indomie Goreng" />
        </div>

        <div>
          <label class="admin-label">Foto Produk (opsional)</label>
          <div class="flex items-center gap-3">
            <div class="w-20 h-20 rounded-xl overflow-hidden bg-[var(--surface-sunken)] shrink-0 flex items-center justify-center border border-[var(--border)]">
              <img x-show="editingProduct.image_url" :src="editingProduct.image_url" class="w-full h-full object-cover" />
              <svg x-show="!editingProduct.image_url" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#9AA6A0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10.5" r="1.5"/><path d="m21 15-5-5L5 19"/></svg>
            </div>
            <div class="flex-1 space-y-1.5">
              <div class="flex gap-2">
                <button type="button" @click="$refs.photoInput.click()" :disabled="photoUploading"
                        class="px-3 py-1.5 rounded-lg border border-[var(--border)] text-[12.5px] font-medium disabled:opacity-60">
                  <span x-show="!photoUploading" x-text="editingProduct.image_url ? 'Ganti Foto' : 'Upload Foto'"></span>
                  <span x-show="photoUploading" x-cloak>Memproses…</span>
                </button>
                <button type="button" x-show="editingProduct.image_url" x-cloak @click="removePhoto()" class="px-3 py-1.5 rounded-lg text-[12.5px] font-medium text-[var(--danger)]">Hapus</button>
              </div>
              <input type="file" x-ref="photoInput" accept="image/*" class="hidden" @change="handlePhotoFile($event)" />
              <p class="text-[11px] text-[var(--ink-muted)]">Otomatis dipotong 1:1 (500×500) & dikompres (~20–40 KB).</p>
              <p x-show="photoError" x-cloak class="text-[11.5px] text-[var(--danger)]" x-text="photoError"></p>
            </div>
          </div>
        </div>

        <div>
          <label class="admin-label">Alias (pisahkan dengan koma)</label>
          <input type="text" x-model="editingProduct.aliasText" class="admin-input" placeholder="mis. miegor, indomie" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="admin-label">Barcode (opsional)</label>
            <input type="text" x-model="editingProduct.barcode" class="admin-input" placeholder="Kosongkan jika tanpa barcode" />
          </div>
        </div>
        </section>

        <section class="border border-[var(--border)] rounded-xl p-3.5 space-y-3">
          <h3 class="form-section-title">Kategori & Lokasi</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="admin-label">Kategori *</label>
              <select x-model="editingProduct.category_id" required class="admin-input">
                <template x-for="cat in allCategories" :key="cat.id">
                  <option :value="cat.id" x-text="cat.name"></option>
                </template>
              </select>
            </div>
            <div>
              <label class="admin-label">Lokasi Rak</label>
              <input type="text" x-model="editingProduct.location_shelf" class="admin-input" placeholder="mis. Rak A1" />
            </div>
          </div>
        </section>
        <section class="border border-[var(--border)] rounded-xl p-3.5 space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="form-section-title !mb-0 !border-b-0 !pb-0">Harga & Satuan</h3>
            <button type="button" @click="addPriceRow()" class="text-[12px] font-semibold text-[var(--primary-dark)] hover:underline">
              + Tambah Satuan
            </button>
          </div>
          <div class="space-y-2">
            <template x-for="(row, idx) in editingProduct.prices" :key="row._key">
              <div class="price-row-grid grid gap-2 items-center" style="grid-template-columns: 1.1fr 1fr 1fr auto;">
                <input type="text" x-model="row.unit" placeholder="Satuan" class="admin-input" />
                <input type="number" min="0" x-model="row.price_public" placeholder="Harga umum" class="admin-input" />
                <input type="number" min="0" x-model="row.price_member" placeholder="Harga anggota" class="admin-input" />
                <button type="button" @click="removePriceRow(idx)"
                        class="w-8 h-8 rounded-lg bg-[var(--surface-sunken)] flex items-center justify-center shrink-0"
                        :disabled="editingProduct.prices.length <= 1">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
                </button>
              </div>
            </template>
          </div>
          <p class="text-[11.5px] text-[var(--ink-muted)]">Kosongkan "Harga anggota" untuk menyamakannya otomatis dengan harga umum.</p>
        </section>

        <section class="border border-[var(--border)] rounded-xl p-3.5 space-y-3">
          <h3 class="form-section-title">Persediaan & Status</h3>
          <div>
            <label class="admin-label">Stok (informatif, opsional)</label>
            <input type="number" x-model="editingProduct.stock" class="admin-input" placeholder="mis. 50" />
          </div>

          <div>
            <label class="admin-label">Catatan</label>
            <textarea x-model="editingProduct.notes" rows="2" class="admin-input" placeholder="Opsional"></textarea>
          </div>

          <label class="flex items-center gap-2 text-[13px] pt-1">
            <input type="checkbox" x-model="editingProduct.is_active" class="w-4 h-4 rounded text-[var(--primary)]" />
            <span>Produk aktif (tampil di aplikasi kasir)</span>
          </label>
        </section>

        <p x-show="formError" x-cloak class="text-[12.5px] text-[var(--danger)] bg-[var(--danger-tint)] rounded-lg px-3 py-2" x-text="formError"></p>

        <div class="flex items-center gap-2.5 pt-2">
          <button type="button" @click="closeProductModal()" class="btn-ghost flex-1">Batal</button>
          <button type="submit" :disabled="savingProduct" class="btn-primary flex-1">
            <span x-show="!savingProduct">Simpan Produk</span>
            <span x-show="savingProduct" x-cloak>Menyimpan…</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- =========================================================
       MODAL: REVIEW IMPORT CSV
  ========================================================== -->
  <div x-show="csvModalOpen" x-cloak class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
    <div class="bg-[var(--surface)] rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <div class="px-5 pt-5 pb-3 border-b border-[var(--border)] flex items-center justify-between sticky top-0 bg-[var(--surface)]">
        <h2 class="text-[15.5px] font-semibold">Review Import CSV</h2>
        <button @click="csvModalOpen = false" class="w-7 h-7 rounded-full bg-[var(--surface-sunken)] flex items-center justify-center">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="px-5 py-4 space-y-4">
        <div class="grid grid-cols-3 gap-2.5 text-center">
          <div class="rounded-xl bg-[#E0F2FE] border border-[#0284C7]/20 py-2.5">
            <p class="text-[18px] font-bold text-[var(--primary-dark)]" x-text="csvNewProducts.length"></p>
            <p class="text-[11px] text-[var(--primary-dark)] font-medium">Produk baru</p>
          </div>
          <div class="rounded-xl bg-amber-50 border border-amber-200 py-2.5">
            <p class="text-[18px] font-bold text-amber-700" x-text="csvConflicts.length"></p>
            <p class="text-[11px] text-amber-700 font-medium">Barcode duplikat</p>
          </div>
          <div class="rounded-xl bg-rose-50 border border-rose-200 py-2.5">
            <p class="text-[18px] font-bold text-rose-700" x-text="csvErrors.length"></p>
            <p class="text-[11px] text-rose-700 font-medium">Baris error</p>
          </div>
        </div>

        <!-- Errors -->
        <div x-show="csvErrors.length" x-cloak>
          <p class="text-[12.5px] font-medium text-[var(--ink-muted)] mb-1.5">Baris dengan error (dilewati otomatis):</p>
          <ul class="text-[12px] text-[var(--danger)] bg-[var(--danger-tint)] rounded-lg px-3 py-2 space-y-1 max-h-32 overflow-y-auto">
            <template x-for="(msg, i) in csvErrors.slice(0, 50)" :key="i">
              <li x-text="msg"></li>
            </template>
          </ul>
          <p x-show="csvErrors.length > 50" x-cloak class="text-[11.5px] text-rose-700 font-medium mt-1.5">
            ...dan <span x-text="csvErrors.length - 50"></span> error lainnya (baris disembunyikan, perbaiki isu di atas dulu).
          </p>
        </div>

        <!-- Conflicts -->
        <div x-show="csvConflicts.length" x-cloak>
          <div class="flex items-center justify-between mb-1.5">
            <p class="text-[12.5px] font-medium text-[var(--ink-muted)]">Barcode sudah terdaftar — pilih aksi per baris:</p>
            <div class="flex gap-2">
              <button type="button" @click="setAllConflictAction('skip')" class="text-[11.5px] underline underline-offset-2">Lewati semua</button>
              <button type="button" @click="setAllConflictAction('overwrite')" class="text-[11.5px] underline underline-offset-2">Timpa semua</button>
            </div>
          </div>
          <div class="border border-[var(--border)] rounded-xl overflow-hidden">
            <table class="w-full text-[12.5px]">
              <thead>
                <tr class="bg-[var(--surface-sunken)] text-left text-[11px] uppercase tracking-wide text-[var(--ink-muted)]">
                  <th class="px-3 py-2 font-medium">Barcode</th>
                  <th class="px-3 py-2 font-medium">Nama Baru (CSV)</th>
                  <th class="px-3 py-2 font-medium">Nama Lama (DB)</th>
                  <th class="px-3 py-2 font-medium">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="(c, i) in csvConflicts" :key="i">
                  <tr class="border-t border-[var(--border)]">
                    <td class="px-3 py-2 font-mono" x-text="c.draft.barcode"></td>
                    <td class="px-3 py-2" x-text="c.draft.name"></td>
                    <td class="px-3 py-2 text-[var(--ink-muted)]" x-text="c.existing.name"></td>
                    <td class="px-3 py-2">
                      <select x-model="c.action" class="admin-input !py-1 !text-[12px]">
                        <option value="skip">Lewati</option>
                        <option value="overwrite">Timpa</option>
                      </select>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
        </div>

        <p x-show="!csvNewProducts.length && !csvConflicts.length && !csvErrors.length" x-cloak class="text-[13px] text-[var(--ink-muted)] text-center py-4">
          Tidak ada baris valid untuk diimpor.
        </p>

        <div class="flex items-center gap-2.5 pt-1">
          <button type="button" @click="csvModalOpen = false" class="btn-ghost flex-1">Batal</button>
          <button type="button" @click="runCsvImport()"
                  :disabled="csvImporting || (!csvNewProducts.length && !csvConflicts.length)"
                  class="btn-primary flex-1">
            <span x-show="!csvImporting">Import Sekarang</span>
            <span x-show="csvImporting" x-cloak>Mengimpor…</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       MODAL: DATABASE MASTER PRODUK
  ========================================================== -->
  <div x-show="masterModalOpen" x-cloak class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-3 sm:p-4">
    <div class="relative bg-[var(--surface)] rounded-2xl w-full max-w-4xl max-h-[92vh] flex flex-col overflow-hidden">
      <div class="px-5 pt-4 pb-3 border-b border-[var(--border)] flex items-start justify-between gap-3 shrink-0 bg-slate-900 text-white">
        <div class="space-y-1 min-w-0">
          <div class="flex items-center gap-2">
            <h2 class="text-[16px] font-bold leading-tight tracking-tight text-white">Database Master Produk</h2>
            <span class="text-[10.5px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-800 text-cyan-300 border border-slate-700 shrink-0">Referensi</span>
          </div>
          <p class="text-[12.5px] text-slate-300 leading-snug">Referensi nama + barcode. Pilih “Gunakan” untuk mengisi form produk katalog.</p>
        </div>
        <button @click="masterModalOpen = false" aria-label="Tutup database master" class="w-9 h-9 rounded-xl hover:bg-slate-800 text-slate-300 flex items-center justify-center shrink-0">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
        </button>
      </div>

      <div x-show="masterImporting" x-cloak x-transition.opacity class="absolute inset-0 z-50 bg-slate-900/90 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="w-full max-w-md rounded-2xl bg-[var(--surface)] border-2 border-[var(--primary)] shadow-2xl p-5 space-y-4">
          <div class="space-y-1">
            <h3 class="text-[17px] font-bold text-[var(--primary-dark)]">Mengimpor Master Produk...</h3>
            <p class="text-[13px] text-[var(--ink-muted)]">
              Batch <span class="font-semibold text-[var(--ink)]" x-text="masterImportStats.currentBatch"></span> dari <span class="font-semibold text-[var(--ink)]" x-text="masterImportStats.totalBatches"></span>
              (<span class="font-semibold text-[var(--primary)]" x-text="masterImportProgress"></span>%)
            </p>
          </div>

          <div class="h-3 rounded-full bg-[var(--surface-sunken)] overflow-hidden border border-[var(--border)]">
            <div class="h-full rounded-full bg-gradient-to-r from-[#075985] to-[#14B8A6] transition-all duration-300 ease-out shadow-lg" :style="'width: ' + masterImportProgress + '%'"></div>
          </div>

          <div class="grid grid-cols-3 gap-2 text-center">
            <div class="rounded-xl bg-slate-50 border border-slate-200 p-3">
              <div class="text-[11.5px] text-[var(--ink-muted)] font-medium">Total Data</div>
              <div class="text-[15px] font-bold text-[var(--ink)]" x-text="masterImportStats.total"></div>
            </div>
            <div class="rounded-xl bg-emerald-50 border border-emerald-200 p-3">
              <div class="text-[11.5px] text-emerald-700 font-medium">Berhasil</div>
              <div class="text-[15px] font-bold text-emerald-700" x-text="masterImportStats.success"></div>
            </div>
            <div class="rounded-xl bg-blue-50 border border-blue-200 p-3">
              <div class="text-[11.5px] text-[var(--primary-dark)] font-medium">Diproses</div>
              <div class="text-[15px] font-bold text-[var(--primary-dark)]" x-text="masterImportStats.processed"></div>
            </div>
          </div>

          <p class="text-[12px] text-amber-700 font-medium text-center bg-amber-50 border border-amber-200 rounded-lg py-2">Mohon jangan tutup atau refresh halaman ini.</p>
        </div>
      </div>

      <div class="flex-1 min-h-0 flex flex-col px-5 py-4 gap-4 overflow-hidden">
        <!-- Primary: Search -->
        <div class="space-y-2.5 shrink-0">
          <label for="masterSearchInput" class="admin-label !mb-0">Cari referensi</label>
          <div class="relative">
            <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[var(--ink-faint)]">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m19 19-3.2-3.2"/></svg>
            </span>
            <input id="masterSearchInput" type="text"
                   x-model="masterSearch"
                   @input.debounce.300ms="searchMaster()"
                   @keydown.enter.prevent="searchMaster()"
                   placeholder="Cari nama produk atau scan barcode..."
                   class="admin-input !pl-9 w-full text-[13.5px] py-2.5" />
          </div>
          <p class="text-[11.5px] text-[var(--ink-muted)] leading-snug">Ketik minimal 1 karakter atau scan barcode. Hasil dibatasi 30 data (server-side).</p>
        </div>

        <!-- Results: reference hierarchy -->
        <div class="flex-1 min-h-0 flex flex-col border border-[var(--border)] rounded-xl overflow-hidden bg-[var(--surface)]">
          <div class="hidden sm:flex items-center text-[10.5px] uppercase tracking-wide font-semibold text-[var(--ink-muted)] bg-[var(--surface-sunken)] border-b border-[var(--border)] px-4 py-2 shrink-0">
            <div class="flex-1">Nama Master</div>
            <div class="flex-[0_0_170px] ml-4">Barcode</div>
            <div class="flex-[0_0_110px] text-right">Aksi</div>
          </div>

          <div class="flex-1 overflow-y-auto overflow-x-hidden overscroll-contain">
            <template x-if="masterSearching">
              <div class="px-4 py-7 space-y-3">
                <div class="h-3.5 rounded-full bg-[var(--surface-sunken)] w-2/3 animate-pulse"></div>
                <div class="h-3 rounded-full bg-[var(--surface-sunken)] w-1/2 animate-pulse"></div>
                <p class="text-[12.5px] text-[var(--ink-muted)] text-center pt-1">Mencari di master_products…</p>
              </div>
            </template>

            <template x-if="!masterSearching && !masterSearch.trim()">
              <div class="px-5 py-10 text-center">
                <div class="w-11 h-11 rounded-2xl bg-[var(--surface-sunken)] mx-auto flex items-center justify-center text-[var(--ink-faint)]">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
                </div>
                <p class="mt-3 text-[13.5px] font-semibold">Mulai cari referensi</p>
                <p class="text-[12.5px] text-[var(--ink-muted)] leading-relaxed mt-1 max-w-[28rem] mx-auto">Ketik nama produk atau scan barcode. Sistem hanya memuat hasil yang cocok — seluruh 28.000+ data tidak dimuat ke browser.</p>
              </div>
            </template>

            <template x-if="!masterSearching && masterSearch.trim() && masterResults.length === 0">
              <div class="px-5 py-10 text-center">
                <div class="w-11 h-11 rounded-2xl bg-[var(--danger-tint)] mx-auto flex items-center justify-center text-[var(--danger)]">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6"/><path d="m15 9-6 6"/></svg>
                </div>
                <p class="mt-3 text-[13.5px] font-semibold">Tidak ada hasil</p>
                <p class="text-[12.5px] text-[var(--ink-muted)] leading-relaxed mt-1 max-w-[28rem] mx-auto">Tidak menemukan referensi untuk “<span class="font-medium text-[var(--ink)] break-words" x-text="masterSearch"></span>”. Perbaiki kata kunci atau cek barcode (leading zero tetap sebagai string).</p>
              </div>
            </template>

            <!-- Desktop rows + Mobile cards from same data -->
            <div class="divide-y divide-[var(--border)]">
              <template x-for="mp in masterResults" :key="mp.id">
                <div class="px-4 py-3.5 flex flex-col sm:flex-row sm:items-center gap-2.5 sm:gap-3 bg-white hover:bg-[var(--surface-sunken)]/40 transition-colors">
                  <div class="min-w-0 flex-1 space-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <p class="text-[13.5px] font-semibold leading-tight text-[var(--ink)] break-words" x-text="mp.name"></p>
                      <span x-show="mp.inCatalog" class="shrink-0 text-[11px] font-semibold px-2 py-0.5 rounded-full bg-[var(--primary-tint)] text-[var(--primary-dark)] border border-[var(--primary-dark)]/10">Di Katalog</span>
                    </div>
                    <p class="flex items-center gap-2 min-w-0">
                      <span class="text-[11px] font-semibold uppercase tracking-wide text-[var(--ink-muted)] shrink-0">Barcode</span>
                      <span class="text-[12px] font-mono text-[var(--ink)] bg-[var(--surface-sunken)] px-2 py-0.5 rounded-lg border border-[var(--border)] break-all" x-text="mp.barcode || '—'"></span>
                    </p>
                  </div>
                  <div class="flex items-center gap-2 sm:ml-auto shrink-0">
                    <span x-show="mp.inCatalog" class="text-[11.5px] font-medium text-[var(--ink-muted)]">Sudah ada di katalog — tidak dapat digunakan.</span>
                    <template x-if="mp.inCatalog">
                      <button disabled class="btn-ghost opacity-60 cursor-not-allowed shrink-0 !font-medium">Sudah Ada</button>
                    </template>
                    <template x-if="!mp.inCatalog">
                      <button @click="useMasterProduct(mp)" class="btn-primary btn-sm shadow-sm">Gunakan</button>
                    </template>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- Separated: Import Master CSV -->
        <section class="shrink-0 rounded-xl border border-dashed border-[var(--border-strong)] bg-[var(--surface-sunken)]/60 p-3.5 space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2.5">
            <div class="space-y-1 min-w-0">
              <p class="text-[12.5px] font-semibold">Import Master CSV</p>
              <p class="text-[11.5px] text-[var(--ink-muted)] leading-snug">Batch 1.000 baris • konflik by barcode (string, leading zero aman) • progress otomatis.</p>
            </div>
            <button @click="$refs.masterCsvInput.click()" class="btn-secondary shrink-0">Import CSV Master</button>
            <input type="file" x-ref="masterCsvInput" accept=".csv" class="hidden" @change="handleMasterCsv($event)" />
          </div>
          <p class="text-[11px] text-[var(--ink-muted)]">Template master: header <span class="font-mono font-medium text-[var(--ink)]">name, barcode</span>. Barcode diproses sebagai string.</p>
        </section>
      </div>
    </div>
  </div>

  <!-- =========================================================
       MODAL: KONFIRMASI IMPORT MASTER CSV
  ========================================================== -->
  <div x-show="masterConfirmModalOpen" x-cloak class="fixed inset-0 z-[60] bg-black/50 flex items-center justify-center p-4">
    <div class="bg-[var(--surface)] rounded-2xl w-full max-w-md p-5 space-y-4 shadow-xl">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-[16px] font-bold text-[var(--ink)]">Konfirmasi Import CSV Master</h3>
          <p class="text-[12.5px] text-[var(--ink-muted)] mt-1">
            Data CSV akan diimpor ke tabel <code class="text-[11.5px] bg-[var(--surface-sunken)] px-1.5 py-0.5 rounded font-mono">master_products</code>.
          </p>
        </div>
        <button @click="masterConfirmModalOpen = false" class="w-8 h-8 rounded-xl bg-[var(--surface-sunken)] hover:bg-slate-200 flex items-center justify-center shrink-0">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="rounded-xl bg-amber-50 border border-amber-200 p-3 text-[12.5px] text-amber-800 space-y-1">
        <p class="font-semibold">Perhatian:</p>
        <ul class="list-disc list-inside space-y-0.5 text-[12px]">
          <li>File ini bisa berisi hingga puluhan ribu baris.</li>
          <li>Proses berjalan bertahap dalam batch (1.000 baris per batch).</li>
        </ul>
      </div>
      <div class="flex items-center gap-2.5 pt-1">
        <button type="button" @click="masterConfirmModalOpen = false; masterImportFile = null;" class="btn-ghost flex-1">Batal</button>
        <button type="button" @click="processMasterCsv()" class="btn-primary flex-1">Lanjutkan Import</button>
      </div>
    </div>
  </div>

  <!-- =========================================================
       MODAL: RINGKASAN HASIL IMPORT MASTER CSV
  ========================================================== -->
  <div x-show="masterResultsModalOpen" x-cloak class="fixed inset-0 z-[60] bg-black/50 flex items-center justify-center p-4">
    <div class="bg-[var(--surface)] rounded-2xl w-full max-w-md p-5 space-y-4 shadow-xl">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-[16px] font-bold text-[var(--ink)]">Import Master Selesai</h3>
          <p class="text-[12.5px] text-[var(--ink-muted)] mt-0.5">Ringkasan hasil pemrosesan CSV Master Produk.</p>
        </div>
        <button @click="masterResultsModalOpen = false" class="w-8 h-8 rounded-xl bg-[var(--surface-sunken)] hover:bg-slate-200 flex items-center justify-center shrink-0">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="grid grid-cols-2 gap-2.5 text-center">
        <div class="rounded-xl bg-slate-50 border border-slate-200 p-3">
          <div class="text-[11.5px] text-[var(--ink-muted)] font-medium">Total CSV</div>
          <div class="text-[16px] font-bold text-[var(--ink)]" x-text="masterImportResults.total"></div>
        </div>
        <div class="rounded-xl bg-emerald-50 border border-emerald-200 p-3">
          <div class="text-[11.5px] text-emerald-700 font-medium">Berhasil</div>
          <div class="text-[16px] font-bold text-emerald-700" x-text="masterImportResults.success"></div>
        </div>
        <div class="rounded-xl bg-amber-50 border border-amber-200 p-3">
          <div class="text-[11.5px] text-amber-700 font-medium">Dilewati (Duplikat)</div>
          <div class="text-[16px] font-bold text-amber-700" x-text="masterImportResults.skipped"></div>
        </div>
        <div class="rounded-xl bg-rose-50 border border-rose-200 p-3">
          <div class="text-[11.5px] text-rose-700 font-medium">Gagal</div>
          <div class="text-[16px] font-bold text-rose-700" x-text="masterImportResults.failed"></div>
        </div>
      </div>
      <div class="pt-1">
        <button type="button" @click="masterResultsModalOpen = false" class="btn-primary w-full">Tutup</button>
      </div>
    </div>
  </div>

  <!-- =========================================================
       TOAST
  ========================================================== -->
  <div x-show="toast" x-cloak x-transition
       class="fixed bottom-5 left-1/2 -translate-x-1/2 z-[60] bg-[var(--ink)] text-white text-[13px] px-4 py-2.5 rounded-xl shadow-lg max-w-sm text-center">
    <span x-text="toast"></span>
  </div>

  <script>
    // =====================================================================
    // KONFIGURASI SUPABASE — GANTI dengan URL & anon key project kamu
    // (harus sama persis dengan yang dipakai di index.html)
    // =====================================================================
    const SUPABASE_URL = "https://mattbitglsoaassjmyhs.supabase.co";
    const SUPABASE_ANON_KEY = "sb_publishable_EKQhuybMHQGSp-Yk2tie7Q_WWnZV9iO";

    const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    function randKey() {
      return Math.random().toString(36).slice(2) + Date.now().toString(36);
    }

    function downloadBlob(text, filename) {
      const blob = new Blob([text], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    // ---- Pemrosesan foto: center-crop 1:1, resize, kompresi JPEG adaptif ----
    function canvasToBlob(canvas, quality) {
      return new Promise((resolve) => canvas.toBlob((b) => resolve(b), "image/jpeg", quality));
    }

    async function centerCropResizeToBlob(file, targetSize, maxBytes) {
      const bitmap = await createImageBitmap(file);
      let size = targetSize;
      let blob = null;

      // eslint-disable-next-line no-constant-condition
      while (true) {
        const canvas = document.createElement("canvas");
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext("2d");

        // center-crop ke rasio 1:1 dari foto asli, lalu skalakan ke `size`
        const cropSize = Math.min(bitmap.width, bitmap.height);
        const sx = (bitmap.width - cropSize) / 2;
        const sy = (bitmap.height - cropSize) / 2;
        ctx.drawImage(bitmap, sx, sy, cropSize, cropSize, 0, 0, size, size);

        // kompresi kualitas JPEG bertahap sampai <= 40KB (target 20–40KB)
        let quality = 0.85;
        blob = await canvasToBlob(canvas, quality);
        while (blob.size > 40 * 1024 && quality > 0.3) {
          quality -= 0.08;
          blob = await canvasToBlob(canvas, quality);
        }

        // kalau di kualitas terendah masih di atas batas maksimal (50KB),
        // perkecil dimensi kanvas dan ulangi (fallback untuk foto yang sangat detail)
        if (blob.size <= maxBytes || size <= 300) break;
        size -= 50;
      }

      if (bitmap.close) bitmap.close();
      return blob;
    }

    // Ekstrak path relatif dari URL publik Supabase Storage, untuk keperluan hapus file
    function extractStoragePath(publicUrl) {
      if (!publicUrl) return null;
      const marker = "/object/public/product-images/";
      const idx = publicUrl.indexOf(marker);
      if (idx === -1) return null;
      return publicUrl.slice(idx + marker.length);
    }

    function adminApp() {
      return {
        // ---- navigation state ----
        mobileMenuOpen: false,

        // ---- auth state ----
        session: null,
        loginEmail: "",
        loginPassword: "",
        loginLoading: false,
        loginError: "",

        // ---- data state ----
        loading: true,
        allProducts: [],
        allCategories: [],
        filtered: [],
        search: "",
        filterCategory: "",
        filterStatus: "",
        page: 1,
        pageSize: 50,

        // ---- product modal ----
        productModalOpen: false,
        editingProduct: null,
        savingProduct: false,
        formError: "",
        photoUploading: false,
        photoError: "",

        // ---- csv import ----
        csvNewProducts: [],
        csvConflicts: [],
        csvErrors: [],
        csvModalOpen: false,
        csvImporting: false,

        // ---- master products ----
        masterModalOpen: false,
        masterSearch: "",
        masterResults: [],
        masterSearching: false,
        masterImporting: false,
        masterImportProgress: 0,
        masterImportStats: { total: 0, processed: 0, success: 0, skipped: 0, failed: 0, currentBatch: 0, totalBatches: 0 },
        masterConfirmModalOpen: false,
        masterImportFile: null,
        masterResultsModalOpen: false,
        masterImportResults: { total: 0, success: 0, skipped: 0, failed: 0 },

        // ---- dashboard stats ----
        statsLoading: true,
        activeProductCount: 0,
        inactiveProductCount: 0,
        masterProductCount: 0,
        categoryCount: 0,

        // ---- toast ----
        toast: "",
        _toastTimer: null,

        // ---- lifecycle ----
        init() {
          supabaseClient.auth.getSession().then(({ data }) => {
            this.session = data.session;
            if (this.session) this.loadData();
          });

          supabaseClient.auth.onAuthStateChange((_event, session) => {
            this.session = session;
            if (session) this.loadData();
          });
        },

        // ---- auth ----
        async login() {
          this.loginLoading = true;
          this.loginError = "";
          const { error } = await supabaseClient.auth.signInWithPassword({
            email: this.loginEmail,
            password: this.loginPassword,
          });
          if (error) {
            this.loginError = error.message === "Invalid login credentials"
              ? "Email atau password salah."
              : error.message;
          }
          this.loginLoading = false;
        },

        async logout() {
          await supabaseClient.auth.signOut();
          this.allProducts = [];
          this.filtered = [];
        },

        // ---- data loading ----
        async loadData() {
          this.loading = true;
          this.statsLoading = true;
          const [{ data: products, error: pErr }, { data: categories, error: cErr }] = await Promise.all([
            supabaseClient
              .from("products")
              // "category:categories(...)" -> embed relasi via FK products.category_id -> categories.id,
              // supaya nama kategori bisa ditampilkan tanpa query terpisah per baris.
              .select("*, category:categories(id,name,icon)")
              .order("name", { ascending: true }),
            supabaseClient.from("categories").select("*").order("sort_order", { ascending: true }),
          ]);

          if (pErr) this.showToast("Gagal memuat produk: " + pErr.message);
          else this.allProducts = (products || []).map((p) => ({ ...p, _imgError: false }));

          if (cErr) this.showToast("Gagal memuat kategori: " + cErr.message);
          else this.allCategories = categories || [];

          this.applyFilters();
          this.loading = false;

          // Fetch dashboard stats with efficient server-side count queries.
          this.loadDashboardStats();
        },

        async countRows(table, filter = null) {
          let query = supabaseClient.from(table).select("*", { count: "exact", head: true });
          if (filter) query = query.eq(filter.column, filter.value);
          const { count, error } = await query;
          if (error) throw error;
          return count || 0;
        },

        async loadDashboardStats() {
          this.statsLoading = true;
          const stats = await Promise.allSettled([
            this.countRows("products", { column: "is_active", value: true }),
            this.countRows("products", { column: "is_active", value: false }),
            this.countRows("master_products"),
            this.countRows("categories"),
          ]);

          const [activeResult, inactiveResult, masterResult, categoryResult] = stats;
          if (activeResult.status === "fulfilled") this.activeProductCount = activeResult.value;
          else console.error("Failed to load active product count:", activeResult.reason);

          if (inactiveResult.status === "fulfilled") this.inactiveProductCount = inactiveResult.value;
          else console.error("Failed to load inactive product count:", inactiveResult.reason);

          if (masterResult.status === "fulfilled") this.masterProductCount = masterResult.value;
          else console.error("Failed to load master product count:", masterResult.reason);

          if (categoryResult.status === "fulfilled") this.categoryCount = categoryResult.value;
          else console.error("Failed to load category count:", categoryResult.reason);

          this.statsLoading = false;
        },

        // Nama kategori untuk ditampilkan — utamakan hasil embed dari loadData(),
        // fallback ke pencarian manual di allCategories (mis. saat data baru saja diedit di client).
        categoryName(p) {
          if (p.category && p.category.name) return p.category.name;
          const cat = this.allCategories.find((c) => c.id === p.category_id);
          return cat ? cat.name : "-";
        },

        // Cari category_id berdasarkan NAMA kategori (dipakai saat import CSV,
        // karena file CSV isinya nama kategori dalam bentuk teks, bukan UUID).
        categoryIdByName(name) {
          const key = (name || "").toString().trim().toLowerCase();
          if (!key) return null;
          const found = this.allCategories.find((c) => c.name.trim().toLowerCase() === key);
          return found ? found.id : null;
        },

        // ---- filter & pagination ----
        applyFilters() {
          let list = this.allProducts;
          const q = this.search.trim().toLowerCase();

          if (q) {
            list = list.filter(
              (p) =>
                p.name.toLowerCase().includes(q) ||
                (p.barcode || "").toLowerCase().includes(q) ||
                (p.alias || []).some((a) => a.toLowerCase().includes(q))
            );
          }
          if (this.filterCategory) list = list.filter((p) => p.category_id === this.filterCategory);
          if (this.filterStatus === "active") list = list.filter((p) => p.is_active);
          if (this.filterStatus === "inactive") list = list.filter((p) => !p.is_active);

          this.filtered = list;
          this.page = 1;
        },

        get totalPages() {
          return Math.max(1, Math.ceil(this.filtered.length / this.pageSize));
        },
        get pagedProducts() {
          const start = (this.page - 1) * this.pageSize;
          return this.filtered.slice(start, start + this.pageSize);
        },
        get paginationLabel() {
          if (this.filtered.length === 0) return "0 produk";
          const start = (this.page - 1) * this.pageSize + 1;
          const end = Math.min(this.page * this.pageSize, this.filtered.length);
          return `Menampilkan ${start}–${end} dari ${this.filtered.length} produk`;
        },
        prevPage() { if (this.page > 1) this.page--; },
        nextPage() { if (this.page < this.totalPages) this.page++; },

        // ---- product modal ----
        emptyPriceRow() {
          return { _key: randKey(), unit: "", price_public: "", price_member: "" };
        },

        openAddModal() {
          this.formError = "";
          this.photoError = "";
          this.editingProduct = {
            id: null,
            master_product_id: null,
            name: "",
            aliasText: "",
            barcode: "",
            category_id: this.allCategories[0]?.id || "",
            location_shelf: "",
            stock: "",
            notes: "",
            is_active: true,
            image_url: null,
            _newUploadPath: null,
            _originalImageUrl: null,
            prices: [this.emptyPriceRow()],
          };
          this.productModalOpen = true;
        },

        openEditModal(p) {
          this.formError = "";
          this.photoError = "";
          this.editingProduct = {
            id: p.id,
            master_product_id: p.master_product_id || null,
            name: p.name,
            aliasText: (p.alias || []).join(", "),
            barcode: p.barcode || "",
            category_id: p.category_id,
            location_shelf: p.location_shelf || "",
            stock: p.stock ?? "",
            notes: p.notes || "",
            is_active: p.is_active,
            image_url: p.image_url || null,
            _newUploadPath: null,
            _originalImageUrl: p.image_url || null,
            prices: (p.prices && p.prices.length ? p.prices : [{ unit: "", price_public: "", price_member: "" }])
              .map((r) => ({ _key: randKey(), unit: r.unit, price_public: r.price_public, price_member: r.price_member })),
          };
          this.productModalOpen = true;
        },

        closeProductModal() {
          // buang foto yang sempat diupload di sesi form ini tapi belum pernah tersimpan ke produk
          if (this.editingProduct && this.editingProduct._newUploadPath) {
            supabaseClient.storage.from("product-images").remove([this.editingProduct._newUploadPath]).catch(() => {});
          }
          this.productModalOpen = false;
          this.editingProduct = null;
          this.photoError = "";
        },

        addPriceRow() {
          this.editingProduct.prices.push(this.emptyPriceRow());
        },
        removePriceRow(idx) {
          if (this.editingProduct.prices.length > 1) this.editingProduct.prices.splice(idx, 1);
        },

        // ---- foto produk: crop 1:1, kompresi adaptif, upload ke Supabase Storage ----
        async handlePhotoFile(event) {
          const file = event.target.files[0];
          event.target.value = ""; // reset agar file yang sama bisa dipilih ulang
          if (!file) return;

          if (!file.type.startsWith("image/")) {
            this.photoError = "File harus berupa gambar (JPG/PNG/dst).";
            return;
          }

          this.photoError = "";
          this.photoUploading = true;

          try {
            const blob = await centerCropResizeToBlob(file, 500, 50 * 1024);
            const path = `products/${randKey()}.jpg`;

            const { error: upErr } = await supabaseClient.storage
              .from("product-images")
              .upload(path, blob, { contentType: "image/jpeg", upsert: true });
            if (upErr) throw upErr;

            // kalau sebelumnya di sesi form ini sudah pernah upload foto baru (ganti berkali-kali
            // sebelum simpan), hapus yang lama supaya tidak menumpuk file yatim di storage
            if (this.editingProduct._newUploadPath) {
              supabaseClient.storage.from("product-images").remove([this.editingProduct._newUploadPath]).catch(() => {});
            }

            const { data: urlData } = supabaseClient.storage.from("product-images").getPublicUrl(path);
            this.editingProduct.image_url = urlData.publicUrl;
            this.editingProduct._newUploadPath = path;
          } catch (err) {
            console.error("Gagal memproses/upload foto:", err);
            this.photoError = "Gagal mengupload foto: " + (err.message || "periksa koneksi & bucket product-images.");
          } finally {
            this.photoUploading = false;
          }
        },

        removePhoto() {
          // hanya hapus langsung dari storage kalau ini foto BARU yang belum pernah tersimpan
          // ke produk (foto lama yang sudah tersimpan baru dihapus setelah form disimpan, lihat saveProduct)
          if (this.editingProduct._newUploadPath) {
            supabaseClient.storage.from("product-images").remove([this.editingProduct._newUploadPath]).catch(() => {});
            this.editingProduct._newUploadPath = null;
          }
          this.editingProduct.image_url = null;
        },

        validateProduct(p) {
          if (!p.name.trim()) return "Nama produk wajib diisi.";
          if (!p.category_id) return "Kategori wajib dipilih.";
          if (!p.prices.length) return "Minimal satu satuan harga wajib diisi.";
          for (const row of p.prices) {
            if (!row.unit || !row.unit.toString().trim()) return "Satuan harga tidak boleh kosong.";
            const pub = Number(row.price_public);
            if (row.price_public === "" || row.price_public === null || isNaN(pub) || pub <= 0) {
              return `Harga umum untuk satuan "${row.unit}" harus angka positif.`;
            }
            if (row.price_member !== "" && row.price_member !== null && row.price_member !== undefined) {
              const mem = Number(row.price_member);
              if (isNaN(mem) || mem < 0) return `Harga anggota untuk satuan "${row.unit}" tidak valid.`;
            }
          }
          return null;
        },

        async saveProduct() {
          const err = this.validateProduct(this.editingProduct);
          if (err) { this.formError = err; return; }

          this.savingProduct = true;
          this.formError = "";

          const isEdit = !!this.editingProduct.id;
          const payload = {
            master_product_id: this.editingProduct.master_product_id || null,
            name: this.editingProduct.name.trim(),
            alias: this.editingProduct.aliasText.split(",").map((s) => s.trim()).filter(Boolean),
            barcode: this.editingProduct.barcode.trim() || null,
            category_id: this.editingProduct.category_id,
            location_shelf: this.editingProduct.location_shelf.trim() || null,
            stock: this.editingProduct.stock === "" ? null : Number(this.editingProduct.stock),
            notes: this.editingProduct.notes.trim() || null,
            is_active: this.editingProduct.is_active,
            image_url: this.editingProduct.image_url || null,
            prices: this.editingProduct.prices.map((r) => ({
              unit: r.unit.toString().trim(),
              price_public: Number(r.price_public),
              price_member: (r.price_member === "" || r.price_member === null || r.price_member === undefined)
                ? Number(r.price_public)
                : Number(r.price_member),
            })),
            updated_by: this.session?.user?.email || null,
          };

          let error;
          if (isEdit) {
            ({ error } = await supabaseClient.from("products").update(payload).eq("id", this.editingProduct.id));
          } else {
            ({ error } = await supabaseClient.from("products").insert(payload));
          }

          this.savingProduct = false;

          if (error) {
            this.formError = error.code === "23505" ? "Barcode ini sudah dipakai produk lain." : error.message;
            return;
          }

          // Save berhasil: foto (kalau ada) sudah resmi jadi bagian produk ini,
          // jangan sampai dihapus oleh cleanup di closeProductModal().
          const originalUrl = this.editingProduct._originalImageUrl;
          this.editingProduct._newUploadPath = null;

          // Kalau foto diganti/dihapus, bersihkan foto LAMA dari storage (aman sekarang karena DB sudah terupdate)
          if (isEdit && originalUrl && originalUrl !== payload.image_url) {
            const oldPath = extractStoragePath(originalUrl);
            if (oldPath) supabaseClient.storage.from("product-images").remove([oldPath]).catch(() => {});
          }

          this.closeProductModal();
          this.showToast(isEdit ? "Produk diperbarui." : "Produk ditambahkan.");
          await this.loadData();
        },

        async toggleActive(p) {
          const nextState = !p.is_active;
          const { error } = await supabaseClient
            .from("products")
            .update({ is_active: nextState, updated_by: this.session?.user?.email || null })
            .eq("id", p.id);

          if (error) { this.showToast("Gagal mengubah status: " + error.message); return; }

          p.is_active = nextState;
          this.showToast(nextState ? `"${p.name}" diaktifkan kembali.` : `"${p.name}" dinonaktifkan.`);
          this.applyFilters();
        },

        // ---- CSV import ----
        handleCsvFile(event) {
          const file = event.target.files[0];
          event.target.value = ""; // reset agar file yang sama bisa dipilih ulang nanti
          if (!file) return;

          Papa.parse(file, {
            header: true,
            skipEmptyLines: true,
            complete: (results) => this.processCsv(results.data),
            error: (err) => this.showToast("Gagal membaca file CSV: " + err.message),
          });
        },

        processCsv(rows) {
          // Guard: file terlalu besar untuk katalog aktif
          if (rows.length > 5000) {
            if (!confirm(
              `File ini berisi ${rows.length.toLocaleString('id-ID')} baris.\n\n` +
              `Import ini untuk KATALOG AKTIF (bukan database master).\n` +
              `Kalau Anda ingin import ke database master, gunakan "Database Master Produk" > "Import CSV Master".\n\n` +
              `Lanjutkan import ${rows.length.toLocaleString('id-ID')} produk ke katalog aktif?`
            )) return;
          }

          const errors = [];
          const draftsByKey = new Map(); // key = barcode, atau 'name:xxx' jika tanpa barcode

          rows.forEach((row, i) => {
            const lineNo = i + 2; // baris 1 = header
            const name = (row.name || "").toString().trim();
            const categoryNameRaw = (row.category || "").toString().trim();
            const unit = (row.unit || "").toString().trim();
            const pricePublicRaw = (row.price_public ?? "").toString().trim();
            const pricePublic = Number(pricePublicRaw);
            const priceMemberRaw = (row.price_member ?? "").toString().trim();
            const priceMember = priceMemberRaw === "" ? pricePublic : Number(priceMemberRaw);
            const barcode = (row.barcode || "").toString().trim();

            if (!name) { errors.push(`Baris ${lineNo}: kolom "name" kosong.`); return; }
            if (!categoryNameRaw) { errors.push(`Baris ${lineNo}: kolom "category" kosong.`); return; }

            // Cocokkan nama kategori dari CSV (teks) ke category_id di database.
            // Kalau tidak ketemu, baris DITOLAK (bukan ditebak/fallback ke kategori lain)
            // supaya tidak ada produk yang diam-diam salah kategori.
            const categoryId = this.categoryIdByName(categoryNameRaw);
            if (!categoryId) {
              errors.push(`Baris ${lineNo}: kategori "${categoryNameRaw}" tidak ditemukan di database — tambahkan kategori ini dulu, atau perbaiki penulisannya di CSV.`);
              return;
            }

            if (!unit) { errors.push(`Baris ${lineNo}: kolom "unit" kosong.`); return; }
            if (!pricePublicRaw || isNaN(pricePublic) || pricePublic <= 0) {
              errors.push(`Baris ${lineNo}: "price_public" harus angka positif.`); return;
            }
            if (isNaN(priceMember) || priceMember < 0) {
              errors.push(`Baris ${lineNo}: "price_member" tidak valid.`); return;
            }

            const key = barcode || "name:" + name.toLowerCase();
            if (!draftsByKey.has(key)) {
              draftsByKey.set(key, {
                name,
                category_id: categoryId,
                alias: (row.alias || "").toString().split(/[;|,]/).map((s) => s.trim()).filter(Boolean),
                barcode: barcode || null,
                location_shelf: (row.location_shelf || "").toString().trim() || null,
                stock: (row.stock ?? "").toString().trim() === "" ? null : Number(row.stock),
                notes: (row.notes || "").toString().trim() || null,
                is_active: (row.is_active ?? "").toString().trim().toLowerCase() !== "false",
                prices: [],
              });
            }
            draftsByKey.get(key).prices.push({ unit, price_public: pricePublic, price_member: priceMember });
          });

          const drafts = Array.from(draftsByKey.values());
          const conflicts = [];
          const newOnes = [];

          drafts.forEach((d) => {
            if (d.barcode) {
              const existing = this.allProducts.find((p) => p.barcode === d.barcode);
              if (existing) { conflicts.push({ draft: d, existing, action: "skip" }); return; }
            }
            newOnes.push(d);
          });

          this.csvErrors = errors;
          this.csvNewProducts = newOnes;
          this.csvConflicts = conflicts;
          this.csvModalOpen = true;
        },

        setAllConflictAction(action) {
          this.csvConflicts.forEach((c) => (c.action = action));
        },

        async runCsvImport() {
          this.csvImporting = true;
          let inserted = 0, updated = 0, skipped = 0, failed = 0;
          const updatedBy = this.session?.user?.email || null;

          for (const d of this.csvNewProducts) {
            const { error } = await supabaseClient.from("products").insert({ ...d, updated_by: updatedBy });
            if (error) failed++; else inserted++;
          }

          for (const c of this.csvConflicts) {
            if (c.action === "skip") { skipped++; continue; }
            const { error } = await supabaseClient
              .from("products")
              .update({ ...c.draft, updated_by: updatedBy })
              .eq("id", c.existing.id);
            if (error) failed++; else updated++;
          }

          this.csvImporting = false;
          this.csvModalOpen = false;
          this.showToast(
            `Import selesai — ${inserted} ditambahkan, ${updated} diperbarui, ${skipped} dilewati` +
            (failed ? `, ${failed} gagal.` : ".")
          );
          await this.loadData();
        },

        downloadTemplate() {
          const header = ["name","alias","barcode","category","unit","price_public","price_member","location_shelf","stock","notes","is_active"];
          const example = [
            {
              name: "Indomie Goreng", alias: "miegor;indomie", barcode: "8992388101015", category: "Sembako",
              unit: "pcs", price_public: 3500, price_member: 3300, location_shelf: "Rak A1", stock: 120, notes: "", is_active: "true",
            },
            {
              name: "Sampoerna Mild", alias: "sampoerna", barcode: "8993212345678", category: "Rokok",
              unit: "batang", price_public: 2200, price_member: 2200, location_shelf: "Rak B2", stock: 40, notes: "", is_active: "true",
            },
            {
              name: "Sampoerna Mild", alias: "sampoerna", barcode: "8993212345678", category: "Rokok",
              unit: "bungkus", price_public: 28000, price_member: 27000, location_shelf: "Rak B2", stock: 40, notes: "", is_active: "true",
            },
          ];
          const csv = Papa.unparse({ fields: header, data: example });
          downloadBlob(csv, "template-import-katalog-koperasi.csv");
        },

        exportCsv() {
          const rows = [];
          this.allProducts.forEach((p) => {
            const priceRows = p.prices && p.prices.length ? p.prices : [{ unit: "", price_public: "", price_member: "" }];
            priceRows.forEach((row) => {
              rows.push({
                name: p.name,
                alias: (p.alias || []).join(";"),
                barcode: p.barcode || "",
                category: this.categoryName(p),
                unit: row.unit,
                price_public: row.price_public,
                price_member: row.price_member,
                location_shelf: p.location_shelf || "",
                stock: p.stock ?? "",
                notes: p.notes || "",
                is_active: p.is_active,
              });
            });
          });
          const csv = Papa.unparse(rows);
          downloadBlob(csv, `katalog-koperasi-export-${new Date().toISOString().slice(0, 10)}.csv`);
        },

        // ---- helpers ----
        formatRupiah(value) {
          if (value === null || value === undefined || value === "") return "-";
          return new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0 }).format(value);
        },

        formatDate(iso) {
          if (!iso) return "-";
          return new Date(iso).toLocaleString("id-ID", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" });
        },

        // ---- master products ----
        async searchMaster() {
          const term = String(this.masterSearch || "").trim();
          if (!term) {
            this.masterResults = [];
            return;
          }

          this.masterSearching = true;
          try {
            let query = supabaseClient.from("master_products").select("*").limit(30);

            // Jika input hanya angka, cari by barcode exact match
            if (/^\d+$/.test(term)) {
              query = query.eq("barcode", term);
            } else {
              // Jika input mengandung huruf, cari by nama (case-insensitive partial match)
              query = query.ilike("name", `%${term}%`);
            }

            const { data, error } = await query;
            if (error) throw error;

            this.masterResults = (data || []).map((mp) => ({
              ...mp,
              inCatalog: mp.barcode ? this.allProducts.some((p) => p.barcode && p.barcode === mp.barcode) : false,
            }));
          } catch (err) {
            this.showToast("Gagal mencari master: " + err.message);
            this.masterResults = [];
          } finally {
            this.masterSearching = false;
          }
        },

        async handleMasterCsv(event) {
          const file = event.target.files[0];
          event.target.value = "";
          if (!file) return;

          this.masterImportFile = file;
          this.masterConfirmModalOpen = true;
        },

        async processMasterCsv() {
          const file = this.masterImportFile;
          if (!file) return;

          this.masterConfirmModalOpen = false;
          const CHUNK_SIZE = 1000;
          try {
            const results = await new Promise((resolve, reject) => Papa.parse(file, {
              header: true,
              skipEmptyLines: true,
              transform: (value, field) => field === "barcode" ? String(value) : value,
              complete: resolve,
              error: reject,
            }));
            const rows = (results.data || []).map((row) => ({
              name: String(row.name || "").trim(),
              barcode: String(row.barcode || "").trim(),
            })).filter((row) => row.name || row.barcode);
            const totalData = rows.length;
            const totalBatches = Math.ceil(totalData / CHUNK_SIZE);

            this.masterImportStats = { total: totalData, processed: 0, success: 0, skipped: 0, failed: 0, currentBatch: 0, totalBatches };
            this.masterImportProgress = 0;
            this.masterImporting = true;

            for (let i = 0; i < totalData; i += CHUNK_SIZE) {
              const chunk = rows.slice(i, i + CHUNK_SIZE);
              this.masterImportStats.currentBatch = Math.floor(i / CHUNK_SIZE) + 1;

              // Pisahkan chunk: dengan barcode vs tanpa barcode
              const withBarcode = [];
              const withoutBarcode = [];
              for (const row of chunk) {
                if (row.barcode) {
                  withBarcode.push({ name: row.name, barcode: row.barcode });
                } else {
                  withoutBarcode.push({ name: row.name, barcode: null });
                }
              }

              let batchSuccess = 0;
              let batchSkipped = 0;
              let batchFailed = 0;

              // Kelompok 1: Punya barcode -> onConflict "barcode"
              if (withBarcode.length > 0) {
                const { data: resBar, error: errBar } = await supabaseClient
                  .from("master_products")
                  .upsert(withBarcode, {
                    onConflict: "barcode",
                    ignoreDuplicates: true,
                    defaultToNull: false,
                  })
                  .select("id");
                if (errBar) {
                  batchFailed += withBarcode.length;
                } else {
                  const ins = resBar ? resBar.length : 0;
                  batchSuccess += ins;
                  batchSkipped += (withBarcode.length - ins);
                }
              }

              // Kelompok 2: Tanpa barcode -> RPC upsert_master_products_no_barcode
              if (withoutBarcode.length > 0) {
                const { data: resNoBar, error: errNoBar } = await supabaseClient
                  .rpc("upsert_master_products_no_barcode", { rows: withoutBarcode });
                if (errNoBar) {
                  batchFailed += withoutBarcode.length;
                } else {
                  const rpcResult = (Array.isArray(resNoBar) ? resNoBar[0] : resNoBar) || { inserted_count: 0, skipped_count: 0 };
                  batchSuccess += Number(rpcResult.inserted_count || 0);
                  batchSkipped += Number(rpcResult.skipped_count || 0);
                }
              }

              this.masterImportStats.success += batchSuccess;
              this.masterImportStats.skipped += batchSkipped;
              this.masterImportStats.failed += batchFailed;
              this.masterImportStats.processed += chunk.length;
              this.masterImportProgress = Math.round((this.masterImportStats.processed / totalData) * 100);
              await new Promise((resolve) => setTimeout(resolve, 0));
            }

            this.masterImporting = false;
            await this.searchMaster();
            const stats = this.masterImportStats;
            this.masterImportResults = {
              total: stats.total,
              success: stats.success,
              skipped: stats.skipped,
              failed: stats.failed,
            };
            this.masterImportFile = null;
            this.masterResultsModalOpen = true;
          } catch (err) {
            this.masterImporting = false;
            this.masterImportFile = null;
            this.showToast("Gagal memproses CSV master: " + err.message);
          }
        },

        async useMasterProduct(mp) {
          if (mp.inCatalog) {
            alert(`Produk ini sudah ada di katalog aktif.`);
            return;
          }

          if (mp.barcode) {
            const { data: existing } = await supabaseClient
              .from("products")
              .select("id, name")
              .eq("barcode", mp.barcode)
              .maybeSingle();

            if (existing) {
              alert(`Produk dengan barcode ${mp.barcode} sudah terdaftar di Katalog Koperasi (${existing.name}).`);
              return;
            }
          }

          this.masterModalOpen = false;
          this.openAddModal();
          this.editingProduct.master_product_id = mp.id || null;
          this.editingProduct.name = mp.name || "";
          this.editingProduct.barcode = mp.barcode || "";
        },

        showToast(msg) {
          this.toast = msg;
          clearTimeout(this._toastTimer);
          this._toastTimer = setTimeout(() => { this.toast = ""; }, 4000);
        },
      };
    }
  </script>
</body>
</html>
